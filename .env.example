# Chave da API do Google Gemini (configure nas Environment Variables do Coolify ou no .env.local)
GEMINI_API_KEY=

# Modelo padrão (padrão: gemini-4-hydrogen)
GEMINI_MODEL=gemini-4-hydrogen

# Supabase Web (Project Settings -> API no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
